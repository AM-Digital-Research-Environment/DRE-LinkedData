; Africa Multiple — DRE Linked Data
; DRE-theme's .editorconfig, copied so every DRE repository indents the same
; way; the block at the end records the files that already use two spaces
; here. LF matches .gitattributes (eol=lf).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{scss,css}]
indent_size = 4

[*.{js,mjs,json}]
indent_size = 4

[*.md]
; Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.ini]
indent_style = space
indent_size = 4

; ── This module only ────────────────────────────────────────────────────
; Composer writes composer.json with two spaces; YAML (workflows, Dependabot,
; CITATION.cff) is conventionally two; the token lint follows its vendored
; library, which DRE-theme writes with two.
[{composer.json,*.{yml,yaml,cff}}]
indent_size = 2

[scripts/{check-design-tokens.mjs,lib/**}]
indent_size = 2
