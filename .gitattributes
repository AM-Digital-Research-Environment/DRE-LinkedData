# Normalise line endings to LF in the repository (cross-platform consistency).
* text=auto eol=lf

# Binary assets — never normalise.
*.png  binary
*.gz   binary
*.mo   binary

# Language stats: .phtml files are Omeka S view templates, i.e. PHP — not HTML.
*.phtml linguist-language=PHP

# The token lint and its table are vendored from DRE-theme.
/scripts/lib/** linguist-vendored

# ---------------------------------------------------------------------------
# Release archive contents
#
# `git archive --prefix=DRELinkedData/` (see .github/workflows/release.yml)
# builds the installable module zip and honours every `export-ignore` below.
# What ships is exactly what Omeka needs at runtime — Module.php, config/, src/,
# view/, asset/, composer.json — plus README, LICENSE and CHANGELOG for whoever
# unpacks it. Everything else is repository furniture and stays out.
#
# Consequence worth knowing: `composer check` does NOT run inside an unpacked
# release, because tests/ and scripts/ are excluded by design. Run it from a clone.
# ---------------------------------------------------------------------------
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.github         export-ignore
/tests           export-ignore
/scripts         export-ignore
/CITATION.cff    export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md     export-ignore
